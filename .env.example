# Local AI conversation. Keep the real key in .env, never in VITE_* variables.
OPENAI_API_KEY=
COMMISSION_AGENT_MODEL=gpt-4.1-mini

# Public hosting only. Leave PUBLIC=0 for your existing local wallet/workspace.
COMMISSION_PUBLIC=0
COMMISSION_PUBLIC_ORIGIN=
COMMISSION_DATA_DIR=.commission-data
# Generate a strong secret on the host; keep it unchanged across redeploys.
COMMISSION_SESSION_SECRET=
COMMISSION_AI_DAILY_LIMIT=100
COMMISSION_AI_USER_DAILY_LIMIT=20
COMMISSION_MAX_ACCOUNTS=100
